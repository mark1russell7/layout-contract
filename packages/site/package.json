{
  "$schema": "https://json.schemastore.org/package",
  "name": "@layout-contract/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:joint": "node scripts/joint-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@layout-contract/joint": "workspace:*",
    "@mark1russell7/highways": "^0.8.1",
    "@mark1russell7/layout-contract": "workspace:*",
    "@mark1russell7/packing": "^0.2.14",
    "marked": "^18.1.2"
  },
  "description": "The GitHub Pages site of layout-contract: the joint benchmark, the strategy-space explorer and the news, from the data in the repository."
}
