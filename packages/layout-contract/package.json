{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/layout-contract",
  "version": "0.2.17",
  "description": "The shared contract of the packing and highways layout engines: the input and record formats, the turn rule, margins, tolerances and hard rules.",
  "keywords": [
    "layout",
    "packing",
    "edge-routing",
    "graph-layout",
    "contract",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/layout-contract#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/layout-contract/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/layout-contract.git",
    "directory": "packages/layout-contract"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsdown": "^0.23.1"
  }
}
