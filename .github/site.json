{
  "$comment": "The site config of this repository (CI.md of the template, \"The site config\"). The Pages workflow deploys this site from main, and a job of ci.yml checks it on each pull request.",
  "build": "pnpm --filter @layout-contract/site run build",
  "out": "packages/site/dist",
  "env": {
    "SITE_BASE": "/{repo}"
  },
  "site-pages": true,
  "packages": "@mark1russell7/layout-contract",
  "site-name": "layout-contract",
  "roadmap": "docs/ROADMAP.md",
  "site-check": true,
  "data-stamps": "packages/site/data/stamps.json",
  "site-check-pages": "/playground.html,/,/compare.html,/releases/,/status/",
  "site-check-probe": "packages/site/src/check-probe.ts"
}
