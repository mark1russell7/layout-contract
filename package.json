{
  "$schema": "https://json.schemastore.org/package",
  "name": "layout-contract-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test && pnpm run test:ai-review",
    "test:ai-review": "node --test \"scripts/ai-review/*.test.ts\"",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@mark1russell7/api-report": "^0.4.1",
    "@mark1russell7/boundaries": "^0.2.0",
    "@mark1russell7/conventions": "^0.35.0",
    "@mark1russell7/cue": "^2.1.1",
    "@mark1russell7/ste-lint": "^0.1.1",
    "@mark1russell7/template-cli": "^0.1.0",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "conventions": {
    "rules": {
      "runner-budget": {
        "ignore": [
          ".github/workflows/memory-probe.yml"
        ],
        "reason": "The nightly memory gate has 6 jobs at once on a stated trial of 3 nights from 2026-11-05 (docs/JOINT-BENCH.md). A dispatch keeps 3. This exception ends with the trial."
      },
      "typed-scripts": {
        "ignore": [
          "packages/*/scripts/*.mjs"
        ],
        "reason": "The bench scripts of packages/*/scripts move to TypeScript in roadmap item L82."
      }
    }
  }
}
